[submodule "kernel/unikraft"]
	path = kernel/unikraft
	url = https://github.com/unikraft/unikraft.git
	branch = plat-hyperlight-v2
[submodule "kernel/app-elfloader"]
	path = kernel/app-elfloader
	# The fork, for two fixes: arm64 AT_HWCAP (upstream has it in another
	# form, which needs a Unikraft change our plat-hyperlight-v2 kernel
	# lacks) and AT_RANDOM on the program's stack, until both are upstream.
	url = https://github.com/danbugs/app-elfloader.git
	branch = plat-hyperlight-v2
[submodule "kernel/libs/libelf"]
	path = kernel/libs/libelf
	url = https://github.com/unikraft/lib-libelf.git
	branch = staging
